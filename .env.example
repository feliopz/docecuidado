# Environment Variables Template

# Supabase (app)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase MCP (opcional — só se usar modo stdio com PAT em vez de OAuth HTTP)
# Project ref = subdomínio da URL ou "Project ID" em Settings → General no dashboard
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# OpenRouter (LLM API)
OPENROUTER_API_KEY=your-openrouter-key-here

# Development
DEBUG=false
LOG_LEVEL=info
