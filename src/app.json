{
  "expo": {
    "name": "Doce Cuidado",
    "slug": "doce-cuidado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "docecuidado",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.docecuidado.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a câmera para fotografar o glicosímetro e registrar refeições.",
        "NSPhotoLibraryUsageDescription": "Usamos a galeria para salvar e carregar fotos de refeições.",
        "NSUserNotificationsUsageDescription": "Enviamos lembretes gentis para registrar a glicemia da criança nos horários do dia."
      }
    },
    "android": {
      "package": "com.docecuidado.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF5EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos a câmera para fotografar o glicosímetro e registrar refeições da criança."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A8D8B9",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "21065fe7-d765-4a73-ae97-ba16669f965f"
      },
      "router": {}
    },
    "owner": "feliopzs-team"
  }
}
